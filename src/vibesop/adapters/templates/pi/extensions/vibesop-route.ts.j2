/**
 * VibeSOP Route Interceptor for Pi Coding Agent
 *
 * Intercepts user input before agent processing and performs VibeSOP routing.
 * When a skill match is found, it injects the skill content into the prompt
 * and guides the agent to follow the skill's instructions.
 *
 * Generated by VibeSOP v{{ vibesop_version }}
 * Platform: Pi Coding Agent (pi)
 */

import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { execFileSync } from "node:child_process";

interface RouteResult {
  has_match: boolean;
  mode?: string;
  skill_file?: string;
  primary?: {
    skill_id: string;
    confidence: number;
    layer?: string;
    source?: string;
  };
  alternatives?: Array<{
    skill_id: string;
    confidence: number;
    layer?: string;
  }>;
}

/** Extract a human-readable name from a skill ID like "builtin/session-end" */
function skillName(skillId: string): string {
  const parts = skillId.split("/");
  return parts[parts.length - 1] || skillId;
}

function runVibeRoute(prompt: string, cwd: string): RouteResult | null {
  try {
    // Pass input as one argument; shell escaping cannot safely preserve it.
    const output = execFileSync(
      "vibe", ["route", "--json", "--yes", prompt],
      {
        cwd,
        encoding: "utf-8",
        timeout: 15000,
        maxBuffer: 1024 * 1024,
      }
    );

    const parsed = JSON.parse(output.trim());
    if (!parsed || typeof parsed !== "object" || typeof parsed.has_match !== "boolean") {
      return null;
    }
    // A valid no-match is distinct from malformed output or a failed command.
    if (!parsed.has_match) return { has_match: false };
    const validSkill = (skill: any): boolean =>
      !!skill && typeof skill.skill_id === "string" && !!skill.skill_id.trim() &&
      typeof skill.confidence === "number" && Number.isFinite(skill.confidence);
    if (!validSkill(parsed.primary) ||
        (parsed.skill_file != null && typeof parsed.skill_file !== "string") ||
        (parsed.alternatives != null &&
          (!Array.isArray(parsed.alternatives) || !parsed.alternatives.every(validSkill)))) {
      return null;
    }
    return parsed as RouteResult;
  } catch (error) {
    // vibe route failed (timeout, parse error, etc.) — pass through normally
    return null;
  }
}

function buildSkillInstruction(
  result: RouteResult,
  _skillsBaseDir: string
): string {
  const skill = result.primary!;
  const name = skillName(skill.skill_id);
  const skillPath = (result.skill_file || "").trim();

  let instruction = `\n\n## VibeSOP Routing Result\n\n`;
  instruction += `Matched skill: **${name}** (${skill.skill_id})\n`;
  instruction += `Confidence: ${Math.round(skill.confidence * 100)}%\n\n`;
  if (skillPath) {
    instruction += `**IMPORTANT**: Read the skill file at \`${skillPath}\` and follow its instructions exactly.\n`;
    instruction += `Use the \`read\` tool to load: \`${skillPath}\`\n`;
  } else {
    instruction += `SKILL.md: not found — do not guess skills/<id>/SKILL.md\n`;
  }

  if (result.alternatives && result.alternatives.length > 0) {
    instruction += `\nAlternative skills:\n`;
    for (const alt of result.alternatives.slice(0, 5)) {
      const altName = skillName(alt.skill_id);
      instruction += `- ${altName} (${alt.skill_id}): ${Math.round(alt.confidence * 100)}%\n`;
    }
  }

  return instruction;
}

export default function (pi: ExtensionAPI) {
  const cwd = process.cwd();
  const skillsBaseDir = ".pi/skills";

  // Intercept user input before agent processing
  pi.on("input", async (event, ctx) => {
    // Skip extension-injected messages to avoid infinite loops
    if (event.source === "extension") return { action: "continue" };

    // Skip explicit skill commands and prompt templates
    if (event.text.startsWith("/skill:") || event.text.startsWith("/vibe-")) {
      return { action: "continue" };
    }

    // Skip very short queries (hello, hi, yes, no, etc.)
    if (event.text.trim().length < 5) {
      return { action: "continue" };
    }

    // Run VibeSOP routing
    const routeResult = runVibeRoute(event.text, cwd);

    // Routing FAILED (timeout, parse error, vibe missing) — pass through
    // silently. Keep this DISTINCT from a clean no-match: per AGENTS.md the
    // agent falls back to a manual `vibe route` when no injection is
    // present, which is the right degraded behavior for a broken hook.
    if (!routeResult) {
      return { action: "continue" };
    }

    // Clean NO-MATCH — say so. Without this fingerprint the agent cannot
    // tell "routing ran, nothing matched" apart from "hook never ran", and
    // its AGENTS.md protocol makes it pay a second `vibe route` on every
    // miss. Parity with the claude/kimi/grok no-match message.
    if (
      !routeResult.has_match ||
      !routeResult.primary ||
      routeResult.primary.skill_id === "fallback-llm"
    ) {
      const noMatchNote =
        "\n\n## VibeSOP Routing Result\n\n" +
        "VibeSOP: No matching skill found. Proceed in normal mode — " +
        "routing has already run for this prompt; do NOT re-run `vibe route`.\n\n" +
        "---\n\nUser request: ";
      return { action: "transform", text: `${noMatchNote}${event.text}` };
    }

    // Build skill instruction for injection
    const skillInstr = buildSkillInstruction(routeResult, skillsBaseDir);

    // Transform the prompt to include routing guidance
    const newText = `${skillInstr}\n\n---\n\nUser request: ${event.text}`;

    return { action: "transform", text: newText };
  });

  // Notify on session start that VibeSOP routing is active
  pi.on("session_start", async (_event, ctx) => {
    ctx.ui.notify("VibeSOP Router active", "info");
  });
}
