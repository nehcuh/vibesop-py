/**
 * VibeSOP Session Tracker for Pi Coding Agent
 *
 * Tracks session activity and provides session-end workflow integration.
 * When the user signals session end, triggers the session-end skill.
 *
 * Generated by VibeSOP v{{ version }}
 * Platform: Pi Coding Agent (pi)
 */

import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

// Session management constants
const SESSION_END_TRIGGERS = [
  "that's all for now",
  "heading out",
  "I'm leaving",
  "I'm done",
  "gotta go",
  "收工",
  "再见",
  "session end",
  "/session-end",
];

function isSessionEndSignal(text: string): boolean {
  const normalized = text.toLowerCase().trim();
  return SESSION_END_TRIGGERS.some(
    (trigger) =>
      normalized === trigger.toLowerCase() ||
      normalized.includes(trigger.toLowerCase())
  );
}

export default function (pi: ExtensionAPI) {
  // Track session start
  pi.on("session_start", async (_event, ctx) => {
    // Notify when VibeSOP tracker is active
  });

  // Intercept session end signals and inject session-end skill
  pi.on("input", async (event, ctx) => {
    if (event.source === "extension") return { action: "continue" };

    if (isSessionEndSignal(event.text)) {
      const newText = `Use the \`read\` tool to load \`.pi/skills/builtin-session-end/SKILL.md\` and follow its instructions exactly.\n\n---\n\nUser request: ${event.text}`;
      return { action: "transform", text: newText };
    }

    return { action: "continue" };
  });

  // Track and log session shutdown
  pi.on("session_shutdown", async (event, _ctx) => {
    // Session shutdown — extensions can log or persist state here
  });
}
