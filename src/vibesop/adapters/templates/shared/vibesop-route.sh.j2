#!/bin/bash
# VibeSOP Route Hook for {{ platform_name }}
# Generated by VibeSOP v{{ version }}
#
# Platform: {{ platform_name }}
# Purpose: {{ purpose }}
#
# Thin shell wrapper — all routing logic lives in AgentRuntime.handle_query().
# Input: JSON via stdin with field "user_prompt", or plain text
# Output: JSON with optional "systemMessage" and "hookSpecificOutput"
{% if platform == "claude-code" %}
# Usage: configure in .claude/settings.json under hooks.UserPromptSubmit
{% elif platform == "opencode" %}
# Usage: echo "/vibe-help" | bash ~/.config/opencode/hooks/vibesop-route.sh
{% elif platform == "kimi-cli" %}
# Usage: configure [[hooks]] in config.toml
{% endif %}

set -e

INPUT=$(cat)

# Try JSON parsing first; fall back to raw input
QUERY=""
if command -v jq &> /dev/null; then
    QUERY=$(echo "$INPUT" | jq -r '.user_prompt // empty' 2>/dev/null || true)
fi
if [ -z "$QUERY" ]; then
    QUERY="$INPUT"
fi

# Skip empty queries
if [ -z "$QUERY" ]; then
    echo '{}'
    exit 0
fi

# Delegate to AgentRuntime (Python)
python3 -c "
import sys, json
from vibesop.agent.runtime import AgentRuntime

query = sys.argv[1] if len(sys.argv) > 1 else ''
runtime = AgentRuntime()
print(runtime.handle_query_for_hook(
    query,
    platform='{{ platform }}',
    hook_event_name='{{ hook_event_name }}',
    include_additional_context={{ 'True' if include_additional_context else 'False' }},
    no_match_message={{ 'True' if no_match_message else 'False' }},
))
" "$QUERY"
