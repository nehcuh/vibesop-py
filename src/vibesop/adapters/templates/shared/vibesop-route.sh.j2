#!/bin/bash
# VibeSOP route hook for {{ platform_name|safe_text }} — {{ purpose|safe_text }}
# Generated by VibeSOP v{{ version|safe_text }}
set -e
# Make common uv install locations discoverable when this hook runs from a
# non-interactive shell (Claude Code / Kimi CLI / etc. invoke hooks with a
# minimal PATH that typically omits ~/.local/bin, /opt/homebrew/bin, etc.)
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

INPUT=$(cat); QUERY=""; SESSION_ID=""
# Different agents use different JSON envelope field names for the user's
# prompt. Try them in order; fall back to raw stdin if none match (or if jq
# is not installed, or if the input is plain text rather than JSON).
# Some agents (kimi -p) send the prompt as a content-block ARRAY
# ([{"type": "text", "text": ...}]), some as a single block OBJECT — unpack
# both to the text; passing the raw blob through made the multi-intent
# detector fire on envelope noise ("type": "text" tokens). An envelope that
# unpacks to EMPTY must not fall back to the raw blob (that would revive
# the bug for image-only blocks): it degrades to a blank query instead.
# printf (not echo) so leading "-n"/"-e" and backslashes in the payload
# survive verbatim.
if command -v jq &> /dev/null; then
    QUERY=$(printf '%s' "$INPUT" | jq -r '
        def text_only:
            if type == "string" then .
            elif type == "object" then (.text | if type == "string" then . else "" end)
            else "" end;
        def unblocks:
            if type == "array" then (map(text_only) | join("\n"))
            elif type == "object" then (.text | if type == "string" then . else "" end)
            else . end;
        if type == "object"
        then (.prompt // .user_prompt // .query // .message // .text // empty
              | unblocks
              | if . == "" then " " else . end)
        else empty
        end' 2>/dev/null || true)
    # Forward the platform session id so route spans carry the real session
    # and can join with tool-call telemetry captured under it (M12 M1);
    # without this the Python side mints a fresh UUID per invocation and the
    # join key breaks. Claude Code / Kimi CLI payloads use "session_id".
    SESSION_ID=$(printf '%s' "$INPUT" | jq -r '
        if type == "object"
        then (.session_id // .sessionId // empty)
        else empty
        end' 2>/dev/null || true)
fi
[ -z "$QUERY" ] && QUERY="$INPUT"
[ -z "$QUERY" ] && { echo '{}'; exit 0; }

# Locate a VibeSOP project root by walking up from the hook script's directory
# looking for pyproject.toml that declares the vibesop package. The hook is
# typically deployed to <project>/.claude/hooks/ or ~/.claude/hooks/, so we
# also fall back to $CLAUDE_PROJECT_DIR and the current directory.
_HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
_VIBESOP_PROJECT_ROOT=""
for _START_DIR in "$_HOOK_DIR/.." "$_HOOK_DIR/../.." "$CLAUDE_PROJECT_DIR" "$PWD" "${VIBESOP_PROJECT_ROOT:-}"; do
    [ -z "$_START_DIR" ] && continue
    _CANDIDATE="$(cd "$_START_DIR" 2>/dev/null && pwd)" || continue
    while [ "$_CANDIDATE" != "/" ]; do
        if [ -f "$_CANDIDATE/pyproject.toml" ] && grep -q -E 'name[[:space:]]*=[[:space:]]*"vibesop"' "$_CANDIDATE/pyproject.toml" 2>/dev/null; then
            _VIBESOP_PROJECT_ROOT="$_CANDIDATE"
            break 2
        fi
        _CANDIDATE="$(dirname "$_CANDIDATE")"
    done
done
if [ -n "$_VIBESOP_PROJECT_ROOT" ]; then
    cd "$_VIBESOP_PROJECT_ROOT"
fi

# Detect a Python that can import vibesop. Never fall through to the
# Windows Store ``python3`` alias (WindowsApps) — it prints
# "Python was not found; ... Microsoft Store" and Claude Code surfaces
# that as a UserPromptSubmit hook error even though ``uv``/``vibe`` exist.
_is_store_python() {
    case "$1" in *WindowsApps*) return 0 ;; esac
    return 1
}
_try_set_python() {
    [ -n "$_VIBESOP_PYTHON" ] && return 0
    if "$@" -c "import vibesop" >/dev/null 2>&1; then
        if [ "$#" -eq 1 ]; then
            _VIBESOP_PYTHON="$1"
        else
            _VIBESOP_PYTHON="$*"
        fi
        return 0
    fi
    return 1
}
_VIBESOP_PYTHON=""
# Only ``uv run`` from a vibesop project root — from a random cwd it can
# stall creating an ephemeral env. Global install is the uv-tool python.
if [ -n "$_VIBESOP_PROJECT_ROOT" ] && command -v uv >/dev/null 2>&1; then
    _try_set_python uv run python || true
fi
# uv tool env: Unix ``bin/python``, Windows ``Scripts/python.exe``.
# Layouts: XDG (~/.local/share), ``uv tool dir`` (Windows = %APPDATA%\uv\tools).
if [ -z "$_VIBESOP_PYTHON" ]; then
    _td=""
    command -v uv >/dev/null 2>&1 && _td=$(uv tool dir 2>/dev/null || true)
    _td=${_td//\\//}
    _appdata=${APPDATA//\\//}
    for _base in \
        "$HOME/.local/share/uv/tools" \
        "${XDG_DATA_HOME:-}/uv/tools" \
        "${_appdata:+$_appdata/uv/tools}" \
        "$_td"
    do
        [ -n "$_base" ] || continue
        for _cand in \
            "$_base/vibesop/bin/python" \
            "$_base/vibesop/Scripts/python.exe" \
            "$_base/vibesop/Scripts/python"
        do
            if [ -e "$_cand" ] && ! _is_store_python "$_cand"; then
                _try_set_python "$_cand" && break 2
            fi
        done
    done
fi
if [ -z "$_VIBESOP_PYTHON" ]; then
    for _cand in python3 python; do
        _resolved=$(command -v "$_cand" 2>/dev/null || true)
        [ -n "$_resolved" ] || continue
        _is_store_python "$_resolved" && continue
        _try_set_python "$_resolved" && break
    done
fi
if [ -z "$_VIBESOP_PYTHON" ]; then
    echo '{}'
    exit 0
fi
if [ "$_VIBESOP_PYTHON" = "uv run python" ]; then
    set -- uv run python
else
    set -- "$_VIBESOP_PYTHON"
fi
"$@" -c "
import sys
from vibesop.agent.runtime import AgentRuntime
r = AgentRuntime()
print(r.handle_query_for_hook(
    sys.argv[1] if len(sys.argv) > 1 else '',
    platform='{{ platform|pyquote }}',
    hook_event_name='{{ hook_event_name|pyquote }}',
    include_additional_context={{ 'True' if include_additional_context else 'False' }},
    no_match_message={{ 'True' if no_match_message else 'False' }},
    session_id=(sys.argv[2] if len(sys.argv) > 2 else '') or None,
))
" "$QUERY" "$SESSION_ID"
