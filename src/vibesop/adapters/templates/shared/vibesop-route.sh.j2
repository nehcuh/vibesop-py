#!/bin/bash
# VibeSOP route hook for {{ platform_name }} — {{ purpose }}
# Generated by VibeSOP v{{ version }}
set -e
INPUT=$(cat); QUERY=""
if command -v jq &> /dev/null; then
    QUERY=$(echo "$INPUT" | jq -r '.user_prompt // empty' 2>/dev/null || true)
fi
[ -z "$QUERY" ] && QUERY="$INPUT"
[ -z "$QUERY" ] && { echo '{}'; exit 0; }
# Detect Python with vibesop available (uv project > system)
_VIBESOP_PYTHON="python3"
if command -v uv &> /dev/null && uv run python -c "import vibesop" 2>/dev/null; then
    _VIBESOP_PYTHON="uv run python"
fi
$_VIBESOP_PYTHON -c "
import sys
from vibesop.agent.runtime import AgentRuntime
r = AgentRuntime()
print(r.handle_query_for_hook(
    sys.argv[1] if len(sys.argv) > 1 else '',
    platform='{{ platform }}',
    hook_event_name='{{ hook_event_name }}',
    include_additional_context={{ 'True' if include_additional_context else 'False' }},
    no_match_message={{ 'True' if no_match_message else 'False' }},
))
" "$QUERY"
