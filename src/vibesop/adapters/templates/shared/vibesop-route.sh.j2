#!/bin/bash
# VibeSOP route hook for {{ platform_name|safe_text }} — {{ purpose|safe_text }}
# Generated by VibeSOP v{{ version|safe_text }}
set -e
# Make common uv install locations discoverable when this hook runs from a
# non-interactive shell (Claude Code / Kimi CLI / etc. invoke hooks with a
# minimal PATH that typically omits ~/.local/bin, /opt/homebrew/bin, etc.)
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

INPUT=$(cat); QUERY=""; SESSION_ID=""
# Different agents use different JSON envelope field names for the user's
# prompt. Try them in order; fall back to raw stdin if none match (or if jq
# is not installed, or if the input is plain text rather than JSON).
if command -v jq &> /dev/null; then
    QUERY=$(echo "$INPUT" | jq -r '
        if type == "object"
        then (.prompt // .user_prompt // .query // .message // .text // empty)
        else empty
        end' 2>/dev/null || true)
    # Forward the platform session id so route spans carry the real session
    # and can join with tool-call telemetry captured under it (M12 M1);
    # without this the Python side mints a fresh UUID per invocation and the
    # join key breaks. Claude Code / Kimi CLI payloads use "session_id".
    SESSION_ID=$(echo "$INPUT" | jq -r '
        if type == "object"
        then (.session_id // .sessionId // empty)
        else empty
        end' 2>/dev/null || true)
fi
[ -z "$QUERY" ] && QUERY="$INPUT"
[ -z "$QUERY" ] && { echo '{}'; exit 0; }

# Locate a VibeSOP project root by walking up from the hook script's directory
# looking for pyproject.toml that declares the vibesop package. The hook is
# typically deployed to <project>/.claude/hooks/ or ~/.claude/hooks/, so we
# also fall back to $CLAUDE_PROJECT_DIR and the current directory.
_HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
_VIBESOP_PROJECT_ROOT=""
for _START_DIR in "$_HOOK_DIR/.." "$_HOOK_DIR/../.." "$CLAUDE_PROJECT_DIR" "$PWD" "${VIBESOP_PROJECT_ROOT:-}"; do
    [ -z "$_START_DIR" ] && continue
    _CANDIDATE="$(cd "$_START_DIR" 2>/dev/null && pwd)" || continue
    while [ "$_CANDIDATE" != "/" ]; do
        if [ -f "$_CANDIDATE/pyproject.toml" ] && grep -q -E 'name[[:space:]]*=[[:space:]]*"vibesop"' "$_CANDIDATE/pyproject.toml" 2>/dev/null; then
            _VIBESOP_PROJECT_ROOT="$_CANDIDATE"
            break 2
        fi
        _CANDIDATE="$(dirname "$_CANDIDATE")"
    done
done
if [ -n "$_VIBESOP_PROJECT_ROOT" ]; then
    cd "$_VIBESOP_PROJECT_ROOT"
fi

# Detect Python with vibesop available (uv project > system). When a project
# root was found, run uv from there so it can locate pyproject.toml.
_VIBESOP_PYTHON="python3"
if [ -n "$_VIBESOP_PROJECT_ROOT" ] && command -v uv &> /dev/null; then
    if (cd "$_VIBESOP_PROJECT_ROOT" && uv run python -c "import vibesop" 2>/dev/null); then
        _VIBESOP_PYTHON="uv run python"
    fi
elif command -v uv &> /dev/null && uv run python -c "import vibesop" 2>/dev/null; then
    _VIBESOP_PYTHON="uv run python"
fi
# Fallback: globally-installed vibesop (uv tool) — its Python can import vibesop
# even when the project root isn't found and system python3 lacks the package.
if [ "$_VIBESOP_PYTHON" = "python3" ]; then
    _UV_TOOL_PYTHON="$HOME/.local/share/uv/tools/vibesop/bin/python"
    [ -x "$_UV_TOOL_PYTHON" ] && "$_UV_TOOL_PYTHON" -c "import vibesop" 2>/dev/null && _VIBESOP_PYTHON="$_UV_TOOL_PYTHON"
fi
$_VIBESOP_PYTHON -c "
import sys
from vibesop.agent.runtime import AgentRuntime
r = AgentRuntime()
print(r.handle_query_for_hook(
    sys.argv[1] if len(sys.argv) > 1 else '',
    platform='{{ platform|pyquote }}',
    hook_event_name='{{ hook_event_name|pyquote }}',
    include_additional_context={{ 'True' if include_additional_context else 'False' }},
    no_match_message={{ 'True' if no_match_message else 'False' }},
    session_id=(sys.argv[2] if len(sys.argv) > 2 else '') or None,
))
" "$QUERY" "$SESSION_ID"
