#!/bin/sh
# VibeSOP Conversation Mirror Hook — Claude Code UserPromptSubmit handler
# Generated by VibeSOP v{{ version|safe_text }}
#
# Purpose: real-time mirror of the user's prompt into the VibeSOP
# conversation store so downstream tooling (dashboard, instinct learner)
# can correlate the user turn with later tool calls and the eventual
# assistant reply. Capture is local-only and opt-in
# (``conversation_mirror.enabled``). Disable with:
#   vibe config set conversation_mirror.enabled false
#
# Input: Claude Code UserPromptSubmit hook JSON via stdin.
# This hook NEVER blocks Claude Code: any failure exits 0 silently.

# Make common uv/vibe install locations discoverable when this hook runs from
# a non-interactive shell (Claude Code invokes hooks with a minimal PATH).
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

INPUT=$(cat)
[ -z "$INPUT" ] && exit 0

# Locate a VibeSOP project root by walking up from the hook script's directory
# (same convention as vibesop-route.sh): used to prefer `uv run` and to decide
# where .vibe/ lives when CLAUDE_PROJECT_DIR is unset.
_HOOK_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
_VIBESOP_PROJECT_ROOT=""
for _START_DIR in "$_HOOK_DIR/.." "$_HOOK_DIR/../.." "$CLAUDE_PROJECT_DIR" "$PWD" "${VIBESOP_PROJECT_ROOT:-}"; do
    [ -z "$_START_DIR" ] && continue
    _CANDIDATE="$(cd "$_START_DIR" 2>/dev/null && pwd)" || continue
    while [ "$_CANDIDATE" != "/" ]; do
        if [ -f "$_CANDIDATE/pyproject.toml" ] && grep -q -E 'name[[:space:]]*=[[:space:]]*"vibesop"' "$_CANDIDATE/pyproject.toml" 2>/dev/null; then
            _VIBESOP_PROJECT_ROOT="$_CANDIDATE"
            break 2
        fi
        _CANDIDATE="$(dirname "$_CANDIDATE")"
    done
done

# Where the conversation store should live: project root injected at render
# time when known (deterministic), otherwise the vibesop project root found
# above, otherwise the Claude Code project dir, otherwise the hook's cwd.
_MIRROR_ROOT={{ project_root|shellquote }}
[ -z "$_MIRROR_ROOT" ] && _MIRROR_ROOT="$_VIBESOP_PROJECT_ROOT"
[ -z "$_MIRROR_ROOT" ] && _MIRROR_ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"

# Append the user prompt turn. Prefer an installed `vibe` binary (fast);
# fall back to `uv run` from the project root. All output and failures are
# swallowed: never block the host agent.
if command -v vibe >/dev/null 2>&1; then
    printf '%s' "$INPUT" | vibe conversation append-turn --project-root "$_MIRROR_ROOT" >/dev/null 2>&1 || true
elif [ -n "$_VIBESOP_PROJECT_ROOT" ] && command -v uv >/dev/null 2>&1; then
    (cd "$_VIBESOP_PROJECT_ROOT" && printf '%s' "$INPUT" | uv run vibe conversation append-turn --project-root "$_MIRROR_ROOT") >/dev/null 2>&1 || true
fi

exit 0
