#!/bin/sh
# VibeSOP Tool Sequence Hook — Claude Code PostToolUse handler
# Generated by VibeSOP v{{ version|safe_text }}
#
# Purpose: capture tool-call sequences (tool name + timestamp + session id
# only — NEVER tool_input, which may contain paths or secrets) for local
# skill-distillation pattern detection (P3). Data lands in
# <project>/.vibe/tool_sequences.jsonl and feeds `vibe sequence assemble`.
# Disable with: vibe config set sequences.enabled false
#
# Input: Claude Code PostToolUse hook JSON via stdin.
# This hook NEVER blocks Claude Code: it always exits 0 and writes nothing to
# stdout. Failures are appended to <root>/.vibe/hook_errors.log (capped);
# every successful capture refreshes <root>/.vibe/tool_sequences.last (epoch
# seconds) as a liveness signal.

# Make common uv/vibe install locations discoverable when this hook runs from
# a non-interactive shell (Claude Code invokes hooks with a minimal PATH).
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

INPUT=$(cat)
[ -z "$INPUT" ] && exit 0

# Locate a VibeSOP project root by walking up from the hook script's directory
# (same convention as vibesop-route.sh): used to prefer `uv run` and to decide
# where .vibe/ lives when CLAUDE_PROJECT_DIR is unset.
_HOOK_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
_VIBESOP_PROJECT_ROOT=""
for _START_DIR in "$_HOOK_DIR/.." "$_HOOK_DIR/../.." "$CLAUDE_PROJECT_DIR" "$PWD" "${VIBESOP_PROJECT_ROOT:-}"; do
    [ -z "$_START_DIR" ] && continue
    _CANDIDATE="$(cd "$_START_DIR" 2>/dev/null && pwd)" || continue
    while [ "$_CANDIDATE" != "/" ]; do
        if [ -f "$_CANDIDATE/pyproject.toml" ] && grep -q -E 'name[[:space:]]*=[[:space:]]*"vibesop"' "$_CANDIDATE/pyproject.toml" 2>/dev/null; then
            _VIBESOP_PROJECT_ROOT="$_CANDIDATE"
            break 2
        fi
        _CANDIDATE="$(dirname "$_CANDIDATE")"
    done
done

# Where the capture data should live. The project the agent is actually
# working in (CLAUDE_PROJECT_DIR) wins: a globally-installed hook is rendered
# with project_root=$HOME, and without this precedence all captures scatter
# into ~/.vibe regardless of the working project (the M12 gate15 BLOCK-2
# root cause — the dogfood repo's .vibe/tool_sequences.jsonl never appeared
# because records landed in ~/.vibe). For project-local installs
# CLAUDE_PROJECT_DIR equals the render-time root anyway. Fallbacks:
# render-time root, vibesop source checkout, cwd.
_SEQ_ROOT="${CLAUDE_PROJECT_DIR:-}"
[ -z "$_SEQ_ROOT" ] && _SEQ_ROOT={{ project_root|shellquote }}
[ -z "$_SEQ_ROOT" ] && _SEQ_ROOT="$_VIBESOP_PROJECT_ROOT"
[ -z "$_SEQ_ROOT" ] && _SEQ_ROOT="$PWD"

# Diagnostics paths. Success stays silent (nothing on stdout); failures go
# to a capped local log; every successful capture rewrites a one-line epoch
# liveness file.
_VIBE_DIR="$_SEQ_ROOT/.vibe"
_ERRLOG="$_VIBE_DIR/hook_errors.log"
_LASTFILE="$_VIBE_DIR/tool_sequences.last"

_log_hook_error() {
    mkdir -p "$_VIBE_DIR" 2>/dev/null || return 0
    # Cap at ~64KB: keep the most recent 200 lines so the log can't grow
    # unbounded (PostToolUse fires after every tool call).
    if [ -f "$_ERRLOG" ] && [ "$(wc -c < "$_ERRLOG" 2>/dev/null | tr -d '[:space:]')" -gt 65536 ] 2>/dev/null; then
        tail -n 200 "$_ERRLOG" > "$_ERRLOG.tmp.$$" 2>/dev/null \
            && mv "$_ERRLOG.tmp.$$" "$_ERRLOG" 2>/dev/null
    fi
    printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)" "$1" >> "$_ERRLOG" 2>/dev/null
    return 0
}

# Record the event. Prefer an installed `vibe` binary (fast — PostToolUse
# fires after every tool call); fall back to `uv run` from the project root.
_RC=0
_OUT=""
if command -v vibe >/dev/null 2>&1; then
    _OUT=$(printf '%s' "$INPUT" | vibe sequence record-tool --project-root "$_SEQ_ROOT" 2>&1) || _RC=$?
elif [ -n "$_VIBESOP_PROJECT_ROOT" ] && command -v uv >/dev/null 2>&1; then
    _OUT=$(cd "$_VIBESOP_PROJECT_ROOT" && printf '%s' "$INPUT" | uv run vibe sequence record-tool --project-root "$_SEQ_ROOT" 2>&1) || _RC=$?
else
    _RC=127
    _OUT="no 'vibe' binary on PATH and no uv fallback (vibesop project root not found)"
fi

if [ "$_RC" -eq 0 ]; then
    # Liveness signal: single-line epoch file, refreshed on every capture.
    mkdir -p "$_VIBE_DIR" 2>/dev/null && date +%s > "$_LASTFILE" 2>/dev/null
else
    _log_hook_error "record-tool failed rc=$_RC: $(printf '%s' "$_OUT" | tr '\n' ' ' | tail -c 400)"
fi

exit 0
