#!/bin/sh
# VibeSOP Conversation Mirror Hook — Claude Code SessionEnd handler
# Generated by VibeSOP v{{ version|safe_text }}
#
# Purpose: at session close, fold the full Claude Code session transcript
# (``~/.claude/projects/<project>/<session-id>.jsonl``) into the VibeSOP
# conversation store via the existing ``import-claude`` subcommand. This
# captures assistant turns that have no real-time hook in Claude Code.
# Local-only and opt-in (``conversation_mirror.enabled``). Disable with:
#   vibe config set conversation_mirror.enabled false
#
# Input: Claude Code SessionEnd hook JSON via stdin (may be empty).
# This hook NEVER blocks Claude Code: any failure exits 0 silently.

# Make common uv/vibe install locations discoverable when this hook runs from
# a non-interactive shell (Claude Code invokes hooks with a minimal PATH).
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

INPUT=$(cat)  # SessionEnd payload is currently unused; reserved for future fields.

# Resolve session id. Prefer jq-extracted field; fall back to env.
_SESSION_ID=""
if command -v jq >/dev/null 2>&1; then
    if [ -n "$INPUT" ]; then
        _SESSION_ID="$(printf '%s' "$INPUT" | jq -r '.session_id // empty' 2>/dev/null || true)"
    fi
fi
[ -z "$_SESSION_ID" ] && _SESSION_ID="${CLAUDE_SESSION_ID:-}"

# Without a session id we cannot locate the transcript — give up silently.
[ -z "$_SESSION_ID" ] && exit 0

# Compute the escaped project segment under ~/.claude/projects/ that Claude
# Code uses for its per-project transcript directory: absolute path with
# every ``/`` replaced by ``-``. Fall back gracefully if CLAUDE_PROJECT_DIR
# is unset (no transcript to import).
_PROJECT_DIR="${CLAUDE_PROJECT_DIR:-}"
[ -z "$_PROJECT_DIR" ] && exit 0
_PROJECT_ESCAPED="$(printf '%s' "$_PROJECT_DIR" | sed 's#/#-#g')"

_JSONL="$HOME/.claude/projects/$_PROJECT_ESCAPED/$_SESSION_ID.jsonl"
[ ! -f "$_JSONL" ] && exit 0

# Locate a VibeSOP project root by walking up from the hook script's
# directory (same convention as vibesop-route.sh): used to prefer `uv run`
# and to decide where .vibe/ lives.
_HOOK_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
_VIBESOP_PROJECT_ROOT=""
for _START_DIR in "$_HOOK_DIR/.." "$_HOOK_DIR/../.." "$CLAUDE_PROJECT_DIR" "$PWD" "${VIBESOP_PROJECT_ROOT:-}"; do
    [ -z "$_START_DIR" ] && continue
    _CANDIDATE="$(cd "$_START_DIR" 2>/dev/null && pwd)" || continue
    while [ "$_CANDIDATE" != "/" ]; do
        if [ -f "$_CANDIDATE/pyproject.toml" ] && grep -q -E 'name[[:space:]]*=[[:space:]]*"vibesop"' "$_CANDIDATE/pyproject.toml" 2>/dev/null; then
            _VIBESOP_PROJECT_ROOT="$_CANDIDATE"
            break 2
        fi
        _CANDIDATE="$(dirname "$_CANDIDATE")"
    done
done

_MIRROR_ROOT={{ project_root|shellquote }}
[ -z "$_MIRROR_ROOT" ] && _MIRROR_ROOT="$_VIBESOP_PROJECT_ROOT"
[ -z "$_MIRROR_ROOT" ] && _MIRROR_ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"

# Truncate the session id to a short, stable conversation id (avoids
# filename length issues and keeps dashboard listings readable).
_CONV_ID="mirror-claude-$(printf '%s' "$_SESSION_ID" | cut -c1-20)"

# Import the transcript. Prefer an installed `vibe` binary; fall back to
# `uv run` from the project root. All output and failures are swallowed:
# never block the host agent.
_STORAGE_DIR="$_MIRROR_ROOT/.vibe/conversations"
if command -v vibe >/dev/null 2>&1; then
    vibe conversation import-claude --source "$_JSONL" --conversation-id "$_CONV_ID" --storage-dir "$_STORAGE_DIR" --include-subagents >/dev/null 2>&1 || true
elif [ -n "$_VIBESOP_PROJECT_ROOT" ] && command -v uv >/dev/null 2>&1; then
    (cd "$_VIBESOP_PROJECT_ROOT" && uv run vibe conversation import-claude --source "$_JSONL" --conversation-id "$_CONV_ID" --storage-dir "$_STORAGE_DIR" --include-subagents) >/dev/null 2>&1 || true
fi

exit 0
