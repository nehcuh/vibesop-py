#!/bin/bash
# Pre-session-end hook for {{ platform|safe_text }}
# Closes the instinct-learning loop: mines the session for patterns and
# promotes matured candidates into skill suggestions.
#
# Generated by VibeSOP - DO NOT EDIT MANUALLY

set -e

echo "[{{ hook_point|safe_text }}] Session ending at $(date)"

if ! command -v vibe &> /dev/null; then
    echo "[{{ hook_point|safe_text }}] VibeSOP CLI not found, skipping instinct learning"
    exit 0
fi

# Locate the session jsonl. Claude Code stores it under
# .claude/projects/<slug>/<session-uuid>.jsonl — take the most recently
# modified one. Other platforms may set $VIBE_SESSION_FILE explicitly.
session_file="${VIBE_SESSION_FILE:-}"
if [ -z "$session_file" ]; then
    session_file=$(find .claude/projects/-* -name "*.jsonl" -type f \
        -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)
fi

# (a) Mine the session for repeated tool patterns → skill suggestions.
#     Idempotent: no-op if SessionAnalyzer finds nothing above threshold.
if [ -n "$session_file" ] && [ -f "$session_file" ]; then
    echo "[{{ hook_point|safe_text }}] Analyzing session: $(basename "$session_file")"
    vibe analyze session "$session_file" || true
else
    # Fall back to current-session discovery inside `vibe analyze session`.
    vibe analyze session || true
fi

# (b) Promote any sequence candidates that matured during this session.
#     Reads .vibe/instincts.jsonl. Idempotent.
echo "[{{ hook_point|safe_text }}] Evaluating instinct candidates"
vibe instinct eval || true

echo "[{{ hook_point|safe_text }}] Instinct learning complete"

# Platform-specific logic
{% if platform == "claude-code" %}
# Additional Claude Code specific logic can go here
{% elif platform == "opencode" %}
# Additional OpenCode specific logic can go here
{% endif %}

exit 0
