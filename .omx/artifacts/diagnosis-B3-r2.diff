+    def call(self, prompt: str, **kwargs: Any) -> Any:
+        body = (
+            '{"passed": false, "issues": ["missing tests"], "score": 1.0, '
+            '"requires_revision": false, "revision_feedback": "add the missing tests"}'
+        )
+        return type("Response", (), {"content": body})()
