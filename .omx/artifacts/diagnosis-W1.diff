+    SKILL_ID = "w1glm-20261009/demo"
+
+    def _manifest(self, central_demo: Path) -> Manifest:
+        return Manifest(
+            metadata=ManifestMetadata(platform="claude-code"),
+            skills=[
+                SkillSpec(
+                    id=self.SKILL_ID,
+                    name="Demo",
+                    description="Demo skill",
+                    trigger_when="testing",
+                    metadata={"source_path": str(central_demo)},
+                )
+            ],
+        )
+
