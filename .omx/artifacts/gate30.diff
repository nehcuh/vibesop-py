+    def find_overlapping_pending(
+        self, task_ids: Iterable[str], *, threshold: float = MERGE_JACCARD_THRESHOLD
+    ) -> ClusterCandidate | None:
+        """Best-overlapping PENDING row for a task_id set, or None.
+
+        gate30 companion to the upsert overlap-merge: callers that must
+        reason about "is this pattern already in the pool?" before
+        mutating (e.g. scan_candidates' gold/miss collision guard) use
+        this instead of exact-id ``get``, because cluster_id drifts with
+        membership growth. Returns the pending row with the highest
+        Jaccard ≥ ``threshold`` (ties → earliest created_at, matching
+        FIFO eviction order). Terminal rows are invisible here, same as
+        in the merge path.
+        """
+        best: ClusterCandidate | None = None
+        best_score = threshold
+        for r in self._read_all_unlocked():
+            if r.status != "pending":
+                continue
+            score = _task_set_jaccard(r.task_ids, task_ids)
+            if score < threshold:
+                continue
+            if (
+                best is None
+                or score > best_score
+                or (score == best_score and r.created_at < best.created_at)
+            ):
+                best, best_score = r, score
+        return best
+
