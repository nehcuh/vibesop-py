+class TestPendingCardsDualScope:
+    def test_global_only_cards_counted(self, tmp_path: Path, monkeypatch) -> None:
+        """复审 claude-MAJOR: --cross-project 候选只落 global store,
+        (b) 口径漏掉它会系统性低估。"""
+        home = tmp_path / "home"
