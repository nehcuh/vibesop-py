+        assert result.exit_code == 0
+        assert "将否决 2 条" in result.output
+        assert "bd1bc217" in result.output  # 修订 E: 确认文案点名先例
+        assert "--yes" in result.output
+        # 未确认 → 无任何变更: 行仍 pending, 否定列表未创建。
