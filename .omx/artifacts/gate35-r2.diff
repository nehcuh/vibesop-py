+    def test_cross_scope_mirror_rows_flipped_together(
+        self, cli_runner: CliRunner, discovery_env
+    ) -> None:
+        """gate35 复审 (pi-MAJOR): 同 cluster_id 在 project+global 各有
+        pending 副本时, 批量否决必须翻转两个 scope —— 否则去重败方的
+        镜像行下次渲染复活。"""
+        stores, _ = discovery_env
