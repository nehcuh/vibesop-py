+def _task_set_jaccard(a: Iterable[str], b: Iterable[str]) -> float:
+    """Jaccard similarity of two task_id sets; 0.0 when both are empty."""
+    sa, sb = set(a), set(b)
+    union = sa | sb
+    if not union:
+        return 0.0
+    return len(sa & sb) / len(union)
+
