+def _cfg_float(config: Any, name: str, default: float) -> float:
+    """Read a float config knob, tolerating MagicMock configs in unit tests.
+
+    ``getattr`` on a MagicMock always succeeds, so a plain ``getattr(...,
+    default)`` would return a MagicMock (not the default) when a test only
+    sets the knobs it cares about. Fall back unless the value is a real
+    number.
+    """
+    value = getattr(config, name, default)
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return default
+    return float(value)
