+    except ValueError as exc:
+        return _fail(98, str(exc))
+    if host in {"", "/"} or _is_drive_root(host):
+        return _fail(99, "refusing root mount")
+    if len(argv) < 2 or argv[-2] != "/bin/sh":
+        return _fail(95, "expected /bin/sh script")
+    script_name = argv[-1]
