+
+def _volume_host(argv: list[str]) -> str:
+    volumes = [argv[i + 1] for i, arg in enumerate(argv) if arg == "-v" and i + 1 < len(argv)]
+    if len(volumes) != 1:
+        raise ValueError("missing volume")
+    return _host_path_from_work_mount(volumes[0])
