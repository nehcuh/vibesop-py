flowchart TB
    R["再次请求全面评审"] --> A["补看旧漏项<br/>或发现改动后的不一致"]
    R -.-> B["改写旧建议<br/>或改变评判范围"]
    A --> L["报告里又出现条目"]
    B -.-> L
    L --> V["对照同一账本<br/>查根因、证据与标准"]
    V --> F["确认的阻塞缺陷<br/>修复并做定向复验"]
    V --> J["非阻塞建议 / 无依据条目<br/>排期、合并或驳回"]
    F --> C["代码或检查范围变化"]
    C --> R
    classDef boundary fill:#fff4df,stroke:#b7873d,color:#654811;
    class B,J boundary;
